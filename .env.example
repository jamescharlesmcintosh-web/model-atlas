# Runpod / LLM provider keys (all optional — app runs in demo mode without them)
# Future AI-analysis provider. Interface in lib/ai-adapter.ts; set one to enable live interpretation.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=

# Optional: default model for AI interpretation (never required for demo)
ATLAS_AI_MODEL=
ATLAS_AI_PROVIDER=mock

# Fetch guardrails
ATLAS_FETCH_TIMEOUT_MS=12000
ATLAS_FETCH_MAX_BYTES=1500000
